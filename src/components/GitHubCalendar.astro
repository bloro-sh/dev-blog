---
import { getContribution, type ContributionResponse } from 'github-contribution-api';

const githubUsername = 'bloro-sh';

const data = (await getContribution(githubUsername, {
  year: 'last',
  format: 'array',
})) as ContributionResponse;

const contributions = data.contributions;
---

<div class="github-calendar" aria-label="GitHub contribution activity">
  <div class="calendar-grid">
    {
      contributions.map((contribution) => (
        <span
          class="contribution-cell"
          data-level={contribution.level}
          title={`${contribution.date}: ${contribution.count} contributions`}
          aria-label={`${contribution.date}: ${contribution.count} contributions`}
        />
      ))
    }
  </div>
</div>

<style>
  .github-calendar {
    width: 100%;
    overflow: visible;
    margin-bottom: var(--space-6);
    display: flex;
    justify-content: center;
  }

  .calendar-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 14px);
    grid-auto-columns: 14px;
    gap: 4px;

    width: max-content;
    flex-shrink: 0;
  }

  .contribution-cell {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: #ebedf0;
  }

  :global([data-theme='dark']) .contribution-cell {
    background: #3a3a3c;
  }

  .contribution-cell[data-level='1'] {
    background: #9be9a8;
  }

  .contribution-cell[data-level='2'] {
    background: #40c463;
  }

  .contribution-cell[data-level='3'] {
    background: #30a14e;
  }

  .contribution-cell[data-level='4'] {
    background: #216e39;
  }

  /* 모바일 */
  @media (max-width: 600px) {
    .github-calendar {
      width: 100%;
      overflow: hidden;
      justify-content: center;
    }

    .calendar-grid {
      width: 100%;
      max-width: 100%;

      grid-template-rows: repeat(7, 1fr);
      grid-auto-columns: 1fr;

      gap: 2px;
    }

    .contribution-cell {
      width: 100%;
      aspect-ratio: 1;
      height: auto;
      border-radius: 2px;
    }
  }
</style>

---
import config from '../../astro-theme-config';
import GitHubCalendar from './GitHubCalendar.astro';

const today = new Date();
const footerTitle = config.site.logoLabel || config.site.title;
---

<footer class="site-footer">
  <div class="footer-inner">
    <GitHubCalendar />

    <p class="footer-copy">
      &copy; {today.getFullYear()}
      {footerTitle}.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: transparent;
    padding: var(--space-4) 0 var(--space-10);
    margin-top: var(--space-4);
  }

  .footer-inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 var(--space-6);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  /* ── Footer copyright ──────────────────── */

  .footer-copy {
    font-size: var(--text-footnote);
    color: var(--label-tertiary);
    margin: 0;
  }

  @media (max-width: 600px) {
    .site-footer {
      margin-top: 0;
      padding-top: 0;
      padding-bottom: var(--space-10);
    }

    .footer-inner {
      padding: 0 var(--space-4);
      gap: var(--space-6);
    }
  }
</style>
